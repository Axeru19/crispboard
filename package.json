{
  "name": "crispboard",
  "version": "1.0.0-alpha.5",
  "description": "Fast, keyboard-first clipboard manager for Windows",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "icons": "node scripts/build-icons.mjs",
    "dist": "electron-builder --win --publish never",
    "e2e": "node scripts/e2e.mjs .scratch/e2e"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "koffi": "^3.3.3"
  },
  "author": "Axel Liuzzi",
  "build": {
    "appId": "it.crispboard.app",
    "productName": "Crispboard",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "assets/**",
      "package.json",
      "node_modules/koffi/**",
      "!node_modules/koffi/doc/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "assets/icon.ico"
    },
    "npmRebuild": false,
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Crispboard",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "Crispboard-Setup-${version}.exe",
      "uninstallDisplayName": "Crispboard"
    }
  },
  "license": "MIT",
  "homepage": "https://github.com/Axeru19/crispboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Axeru19/crispboard.git"
  },
  "bugs": {
    "url": "https://github.com/Axeru19/crispboard/issues"
  },
  "keywords": [
    "clipboard",
    "clipboard-manager",
    "windows",
    "electron",
    "ditto",
    "productivity"
  ],
  "engines": {
    "node": ">=24"
  },
  "os": [
    "win32"
  ]
}
