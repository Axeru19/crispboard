{
  "name": "crispboard",
  "version": "1.0.0",
  "description": "Gestore di clipboard per Windows",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "icons": "node scripts/build-icons.mjs",
    "dist": "electron-builder --win dir",
    "e2e": "node scripts/e2e.mjs .scratch/e2e"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "koffi": "^3.3.3"
  },
  "author": "axel",
  "build": {
    "appId": "it.crispboard.app",
    "productName": "Crispboard",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "assets/**",
      "package.json",
      "node_modules/koffi/**",
      "!node_modules/koffi/doc/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "assets/icon.ico"
    },
    "npmRebuild": false
  }
}